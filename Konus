function Notify(text, dur)
    dur = dur or 4
    pcall(function()
        SG:SetCore("SendNotification", {
            Title = "Konus Music",
            Text = text,
            Duration = dur
        })
    end)
end

-- ============================================================
-- БЕЗОПАСНЫЙ МЕТОД: Радио в машине (не триггерит античит)
-- ============================================================
function PlayCarRadio(id)
    local soundId = "rbxassetid://" .. id
    
    if LP.Character and LP.Character:FindFirstChild("Humanoid") then
        local seat = LP.Character.Humanoid.SeatPart
        
        if seat then
            local car = seat.Parent
            while car and not car:IsA("Model") do
                car = car.Parent
            end
            
            if car then
                -- Ищем ТОЛЬКО Sound внутри машины (RemoteEvents не трогаем)
                local found = false
                for _, v in pairs(car:GetDescendants()) do
                    if v:IsA("Sound") then
                        pcall(function()
                            v.SoundId = soundId
                            v.Volume = 5
                            v.Looped = true
                            v:Play()
                        end)
                        found = true
                    end
                end
                
                if found then
                    return true
                end
            end
        end
    end
    
    return false
end

-- ============================================================
-- БЕЗОПАСНЫЙ МЕТОД 2: Локальный плеер (только для тебя)
-- ============================================================
function PlayLocalSound(id)
    -- Создаём тихий звук рядом с собой (безопасно)
    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://" .. id
        sound.Volume = 5
        sound.Looped = true
        sound.Parent = LP.Character.HumanoidRootPart
        sound:Play()
        
        -- Удаляем старый звук если есть
        for _, v in pairs(LP.Character.HumanoidRootPart:GetChildren()) do
            if v:IsA("Sound") and v ~= sound and v.Name == "KonusMusic" then
                v:Destroy()
            end
        end
        sound.Name = "KonusMusic"
        
        return sound
    end
    return nil
end

-- ============================================================
-- БЕЗОПАСНЫЙ МЕТОД 3: Ищем существующие радио на карте
-- ============================================================
function FindAndPlayRadios(id)
    local soundId = "rbxassetid://" .. id
    local count = 0
    
    -- Ищем ТОЛЬКО Sound объекты в workspace (не трогаем RemoteEvents!)
    for _, v in pairs(WS:GetDescendants()) do
        if v:IsA("Sound") then
            local parent = v.Parent
            -- Проверяем, что это радио или колонка
            if parent and (parent.Name:lower():find("radio") or 
                          parent.Name:lower():find("boombox") or 
                          parent.Name:lower():find("speaker") or
                          parent.Name:lower():find("stereo") or
                          parent.Name:lower():find("music")) then
                pcall(function()
                    v.SoundId = soundId
                    v.Volume = 5
                    v.Looped = true
                    v:Play()
                end)
                count = count + 1
            end
        end
    end
    
    return count
end

