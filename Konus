-- ============================================================
-- ФУНКЦИЯ ПОИСКА ИГРОКА
-- ============================================================
function FindPlayer(name)
    -- Точное совпадение
    local exact = Players:FindFirstChild(name)
    if exact and exact ~= LP then
        return exact
    end
    
    -- Частичное совпадение
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Name:lower():find(name:lower()) then
            return p
        end
    end
    
    return nil
end

