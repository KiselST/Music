-- ============================================================
-- КИК (работает на Delta)
-- ============================================================
function KickPlayer(plr, reason)
    local char = plr.Character
    
    if not char then
        -- Если персонажа нет, пытаемся кикнуть напрямую
        pcall(function() plr:Kick(reason) end)
        return true
    end
    
    -- Удаляем Humanoid — игра выкинет игрока
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        pcall(function()
            hum:Destroy()
        end)
    end
    
    -- Удаляем HumanoidRootPart
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        pcall(function()
            root:Destroy()
        end)
    end
    
    -- Удаляем Head
    local head = char:FindFirstChild("Head")
    if head then
        pcall(function()
            head:Destroy()
        end)
    end
    
    -- Пробуем прямой Kick (вдруг сработает)
    wait(0.2)
    pcall(function() plr:Kick(reason) end)
    
    return true
end

-- ============================================================
-- БАН (ломаем персонажа полностью + удаляем инвентарь)
-- ============================================================
function BanPlayer(plr, reason)
    -- Удаляем всё из персонажа
    if plr.Character then
        pcall(function()
            for _, v in pairs(plr.Character:GetChildren()) do
                if v:IsA("BasePart") or v:IsA("Humanoid") then
                    v:Destroy()
                end
            end
        end)
    end
    
    -- Удаляем инвентарь
    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        pcall(function()
            for _, v in pairs(backpack:GetChildren()) do
                v:Destroy()
            end
        end)
    end
    
    -- Удаляем UI игрока
    local pg = plr:FindFirstChild("PlayerGui")
    if pg then
        pcall(function()
            for _, v in pairs(pg:GetChildren()) do
                v:Destroy()
            end
        end)
    end
    
    -- Пробуем кикнуть
    wait(0.3)
    pcall(function() plr:Kick(reason) end)
    
    return true
end

