function UpdatePlayerList()
    -- Очищаем старый список
    for _, v in pairs(DropList:GetChildren()) do
        if v:IsA("TextButton") then
            v:Destroy()
        end
    end
    
    -- Заполняем новый
    local players = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then
            table.insert(players, p)
        end
    end
    
    if #players == 0 then
        DropdownBtn.Text = "▼ Нет игроков"
        SelectedPlayer = nil
        DropList.Size = UDim2.new(1, -20, 0, 0)
        return
    end
    
    DropList.Size = UDim2.new(1, -20, 0, #players * 26)
    
    for _, p in pairs(players) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 26)
        btn.BackgroundTransparency = 1
        btn.Text = "👤 " .. p.Name
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 11
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.ZIndex = 11
        btn.Parent = DropList
        
        btn.MouseButton1Click:Connect(function()
            DropdownBtn.Text = "▼ " .. p.Name
            SelectedPlayer = p
            DropList.Visible = false
            Notify("🎯 Выбран: " .. p.Name)
        end)
    end
    
    -- Авто-выбор первого
    if #players > 0 and not SelectedPlayer then
        SelectedPlayer = players[1]
        DropdownBtn.Text = "▼ " .. players[1].Name
    end
end

-- Открытие/закрытие списка
DropdownBtn.MouseButton1Click:Connect(function()
    UpdatePlayerList()
    DropList.Visible = not DropList.Visible
end)

