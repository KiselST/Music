local invisible = false

function SetInvisible(state)
    invisible = state
    if state then
        spawn(function()
            while invisible do
                if LP.Character then
                    for _, v in pairs(LP.Character:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.Transparency = 1
                        end
                    end
                end
                wait(0.1)
            end
        end)
    else
        if LP.Character then
            for _, v in pairs(LP.Character:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Transparency = 0
                end
            end
        end
    end
end

