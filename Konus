-- Функция: найти все динамики на сервере
local function GetAllSpeakers()
    local speakers = {}
    
    -- Ищем Sound в workspace
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Sound") then
            table.insert(speakers, v)
        end
    end
    
    -- Ищем в Radio, Boombox, MusicPlayer итд
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and (v.Name:lower():find("radio") or v.Name:lower():find("boombox") or v.Name:lower():find("speaker") or v.Name:lower():find("music")) then
            for _, s in pairs(v:GetDescendants()) do
                if s:IsA("Sound") then
                    table.insert(speakers, s)
                end
            end
        end
    end
    
    -- Ищем в ReplicatedStorage (иногда там хранятся)
    for _, v in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        if v:IsA("Sound") then
            table.insert(speakers, v)
        end
    end
    
    return speakers
end

-- Функция: создать глобальный звук
local function PlayGlobalSound(id)
    local soundId = "rbxassetid://" .. id
    
    -- Способ 1: Спавним Boombox/Radio в workspace
    local boombox = Instance.new("Sound")
    boombox.SoundId = soundId
    boombox.Volume = 10
    boombox.Playing = true
    boombox.Parent = workspace
    boombox.Name = "KonusMusic"
    
    -- Размещаем звук на всех игроках для максимального покрытия
    spawn(function()
        while boombox.Playing do
            for _, plr in pairs(Players:GetPlayers()) do
                if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    -- Двигаем звук к игрокам для глобального слышимости
                    boombox.Position = plr.Character.HumanoidRootPart.Position
                    wait(0.1)
                end
            end
            wait(0.5)
        end
    end)
    
    -- Способ 2: Пытаемся найти существующие динамики и включить в них
    local speakers = GetAllSpeakers()
    if #speakers > 0 then
        for _, speaker in pairs(speakers) do
            pcall(function()
                speaker.SoundId = soundId
                speaker.Volume = 10
                speaker:Play()
            end)
        end
        Notify("Найдено динамиков: " .. #speakers)
    end
    
    return boombox
end

-- Текущий звук
local currentSound = nil

-- Кнопка ИГРАТЬ
PlayBtn.MouseButton1Click:Connect(function()
    local id = IDBox.Text
    if id == "" then
        Notify("Введите ID музыки!")
        return
    end
    
    -- Убираем всё кроме цифр
    id = id:gsub("%D", "")
    
    if id == "" then
        Notify("Неверный ID!")
        return
    end
    
    -- Останавливаем предыдущий звук
    if currentSound then
        pcall(function() currentSound:Stop() end)
        pcall(function() currentSound:Destroy() end)
    end
    
    -- Запускаем новый
    currentSound = PlayGlobalSound(id)
    Notify("🎵 Играет: " .. id)
    
    -- Авто-остановка через 5 минут
    spawn(function()
        wait(300)
        if currentSound then
            pcall(function() currentSound:Stop() end)
            pcall(function() currentSound:Destroy() end)
            currentSound = nil
        end
    end)
end)

-- Кнопка СТОП
StopBtn.MouseButton1Click:Connect(function()
    if currentSound then
        pcall(function() currentSound:Stop() end)
        pcall(function() currentSound:Destroy() end)
        currentSound = nil
    end
    
    -- Останавливаем все звуки KonusMusic
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Sound") and v.Name == "KonusMusic" then
            pcall(function() v:Stop() end)
            pcall(function() v:Destroy() end)
        end
    end
    
    -- Останавливаем динамики
    local speakers = GetAllSpeakers()
    for _, speaker in pairs(speakers) do
        pcall(function() speaker:Stop() end)
    end
    
    Notify("⏹ Музыка остановлена")
end)

