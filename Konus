PlayBtn.MouseButton1Click:Connect(function()
    local id = IDBox.Text:gsub("%D", "")
    if id == "" then Notify("❌ Введи ID!"); return end
    
    Notify("🔍 Пробую все методы...")
    
    -- Метод 1: Радио в машине
    local carSuccess = PlayCarRadio(id)
    
    -- Метод 2: Все радио на карте
    local radioCount = PlayAllRadios(id)
    if radioCount > 0 then
        Notify("✅ Найдено радио: " .. radioCount)
    end
    
    -- Метод 3: Спавн бумбокса
    local spawnSuccess = SpawnBoombox(id)
    
    -- Метод 4: Глобальные RemoteEvents
    local remoteCount = UseGlobalRemotes(id)
    if remoteCount > 0 then
        Notify("✅ Отправлено через " .. remoteCount .. " RemoteEvents")
    end
    
    if carSuccess or radioCount > 0 or spawnSuccess or remoteCount > 0 then
        Notify("🎵 МУЗЫКА ИГРАЕТ! ID: " .. id)
        Notify("💡 Сядь в машину для лучшего эффекта")
    else
        Notify("⚠ Не удалось включить")
        Notify("💡 Сядь в машину и попробуй ещё раз")
    end
end)

CarBtn.MouseButton1Click:Connect(function()
