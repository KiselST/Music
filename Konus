function Notify(text, dur)
    dur = dur or 4
    pcall(function()
        SG:SetCore("SendNotification", {
            Title = "Konus Music",
            Text = text,
            Duration = dur
        })
    end)
end

-- ============================================================
-- МЕТОД 1: Заспавнить бумбокс через инвентарь (обход доната)
-- ============================================================
function SpawnBoombox(id)
    local soundId = "rbxassetid://" .. id
    local success = false
    
    -- Ищем бумбокс в ReplicatedStorage или любых других хранилищах
    local boomboxTemplate = nil
    
    -- Путь 1: Прямой поиск модели Boombox
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("Model") and v.Name:lower():find("boombox") then
            boomboxTemplate = v
            break
        end
    end
    
    -- Путь 2: Поиск в Tool (инструменты)
    if not boomboxTemplate then
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("Tool") and v.Name:lower():find("boombox") then
                boomboxTemplate = v
                break
            end
        end
    end
    
    -- Путь 3: Поиск в игровом инвентаре
    if not boomboxTemplate then
        local backpack = LP:FindFirstChild("Backpack")
        if backpack then
            for _, v in pairs(backpack:GetChildren()) do
                if v.Name:lower():find("boombox") then
                    boomboxTemplate = v
                    break
                end
            end
        end
    end
    
    -- Если нашли шаблон - клонируем и спавним
    if boomboxTemplate and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local clone = boomboxTemplate:Clone()
        clone.Parent = WS
        
        -- Ставим рядом с игроком
        local root = LP.Character.HumanoidRootPart
        if clone:IsA("Model") then
            local primary = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart")
            if primary then
                clone:SetPrimaryPartCFrame(root.CFrame * CFrame.new(2, -2, 0))
            end
        end
        
        -- Включаем музыку внутри клона
        for _, s in pairs(clone:GetDescendants()) do
            if s:IsA("Sound") then
                pcall(function()
                    s.SoundId = soundId
                    s.Volume = 10
                    s.Playing = true
                end)
            end
            -- Пробуем RemoteEvent
            if s:IsA("RemoteEvent") then
                pcall(function()
                    s:FireServer(id)
                    s:FireServer(soundId)
                    s:FireServer("Play", id)
                end)
            end
        end
        
        Notify("✅ Бумбокс заспавнен!")
        success = true
    end
    
    return success
end

-- ============================================================
-- МЕТОД 2: Найти и включить радио в машине
-- ============================================================
function PlayCarRadio(id)
    local soundId = "rbxassetid://" .. id
    local success = false
    
    -- Ищем машину, в которой сидит игрок
    if LP.Character and LP.Character:FindFirstChild("Humanoid") then
        local seat = LP.Character.Humanoid.SeatPart
        if seat then
            -- Мы в машине! Ищем радио
            local car = seat.Parent
            while car and not car:IsA("Model") do
                car = car.Parent
            end
            
            if car then
                -- Ищем Sound или Radio внутри машины
                for _, v in pairs(car:GetDescendants()) do
                    if v:IsA("Sound") then
                        pcall(function()
                            v.SoundId = soundId
                            v.Volume = 10
                            v:Play()
                        end)
                        success = true
                    end
                    if v:IsA("RemoteEvent") and (v.Name:lower():find("radio") or v.Name:lower():find("music")) then
                        pcall(function()
                            v:FireServer(id)
                        end)
                        success = true
                    end
                end
                
                if success then
                    Notify("✅ Радио в машине включено!")
                end
            end
        end
    end
    
    return success
end

-- ============================================================
-- МЕТОД 3: Найти все радио на карте и включить
-- ============================================================
function PlayAllRadios(id)
    local soundId = "rbxassetid://" .. id
    local count = 0
    
    -- Ищем все радио/бумбоксы/колонки на карте
    for _, v in pairs(WS:GetDescendants()) do
        -- По названию
        local isRadio = false
        local name = v.Name:lower()
        if name:find("radio") or name:find("boombox") or name:find("speaker") or name:find("stereo") or name:find("music") then
            isRadio = true
        end
        
        -- По наличию Sound внутри
        if v:IsA("Model") then
            for _, child in pairs(v:GetDescendants()) do
                if child:IsA("Sound") then
                    isRadio = true
                    break
                end
            end
        end
        
        if isRadio then
            -- Включаем все Sound внутри
            for _, s in pairs(v:GetDescendants()) do
                if s:IsA("Sound") then
                    pcall(function()
                        s.SoundId = soundId
                        s.Volume = 10
                        s:Play()
                    end)
                    count = count + 1
                end
            end
            
            -- Дёргаем RemoteEvents
            for _, r in pairs(v:GetDescendants()) do
                if r:IsA("RemoteEvent") then
                    pcall(function()
                        r:FireServer(id)
                        r:FireServer(soundId)
                        r:FireServer("Play", id)
                    end)
                end
            end
        end
    end
    
    return count
end

-- ============================================================
-- МЕТОД 4: Использовать глобальные RemoteEvents
-- ============================================================
function UseGlobalRemotes(id)
    local soundId = "rbxassetid://" .. id
    local sent = 0
    
    -- Собираем ВСЕ RemoteEvents в игре
    local allRemotes = {}
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            table.insert(allRemotes, v)
        end
    end
    
    -- Пробуем отправить музыку через каждый
    for _, remote in pairs(allRemotes) do
        pcall(function()
            remote:FireServer(id)                      -- Просто ID
            remote:FireServer(soundId)                 -- Полный URL
            remote:FireServer(tonumber(id))            -- Число
            remote:FireServer("PlaySong", id)          -- Команда + ID
            remote:FireServer("PlayMusic", id)         -- Альтернатива
            remote:FireServer("MusicID", id)           -- Название параметра
            remote:FireServer("SoundId", id)           -- Другой формат
            remote:FireServer({MusicID = id})          -- Как таблица
            sent = sent + 1
        end)
    end
    
    return sent
end

