local currentSound = nil

PlayBtn.MouseButton1Click:Connect(function()
    local id = IDBox.Text:gsub("%D", "")
    if id == "" then
        Notify("❌ Введи ID музыки!")
        return
    end
    
    local success = false
    
    -- Метод 1: Машина (самый безопасный)
    local carSuccess = PlayCarRadio(id)
    if carSuccess then
        Notify("✅ Радио в машине играет!")
        Notify("🎵 Слышно всем рядом с машиной")
        success = true
    end
    
    -- Метод 2: Ищем существующие радио (безопасно)
    local radioCount = FindAndPlayRadios(id)
    if radioCount > 0 then
        Notify("✅ Найдено колонок: " .. radioCount)
        success = true
    end
    
    -- Метод 3: Локальный звук (запасной)
    if not success then
        currentSound = PlayLocalSound(id)
        Notify("🎧 Локальное воспроизведение")
        Notify("⚠ Слышно только тебе. Сядь в машину!")
    end
    
    if success and not carSuccess then
        Notify("💡 Для всех: сядь в машину")
    end
end)

StopBtn.MouseButton1Click:Connect(function()
    -- Останавливаем локальный звук
    if currentSound then
        pcall(function() currentSound:Stop() end)
        pcall(function() currentSound:Destroy() end)
        currentSound = nil
    end
    
    -- Останавливаем звук на персонаже
    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        for _, v in pairs(LP.Character.HumanoidRootPart:GetChildren()) do
            if v:IsA("Sound") then
                pcall(function() v:Stop() end)
                pcall(function() v:Destroy() end)
            end
        end
    end
    
    Notify("⏹ Музыка остановлена")
end)

